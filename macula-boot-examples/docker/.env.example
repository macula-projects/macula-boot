# Local-only Docker example defaults. Do not reuse these credentials outside localhost.
MYSQL_IMAGE=mysql:8.0.43
REDIS_IMAGE=redis:7.4.5
NACOS_IMAGE=nacos/nacos-server:v2.5.1-slim
POLARIS_IMAGE=polarismesh/polaris-server:v1.18.1
CURL_IMAGE=curlimages/curl:8.16.0

MYSQL_ROOT_PASSWORD=polaris
MYSQL_DATABASE=nacos_config
MYSQL_USER=nacos
MYSQL_PASSWORD=nacos
REDIS_PASSWORD=redis

NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=MACULA5
POLARIS_NAMESPACE=macula-dev

MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
POLARIS_HTTP_PORT=8090
POLARIS_DISCOVERY_GRPC_PORT=8091
POLARIS_CONFIG_GRPC_PORT=8093
POLARIS_NACOS_PORT=18849
POLARIS_NACOS_GRPC_PORT=19849

ALIBABA_PROVIDER_PORT=7081
ALIBABA_CONSUMER_PORT=7090
ALIBABA_GATEWAY_HTTP_PORT=8000
ALIBABA_GATEWAY_HTTPS_PORT=8443
TENCENT_PROVIDER_PORT=4011
TENCENT_CONSUMER_PORT=4019
TENCENT_GATEWAY_PORT=4010
