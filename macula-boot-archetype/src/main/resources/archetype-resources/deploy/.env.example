# 仅用于本地开发。复制为 deploy/.env 后修改，禁止填写生产凭据。
COMPOSE_PROJECT_NAME=${rootArtifactId}-dev
BIND_ADDRESS=127.0.0.1

MYSQL_IMAGE=mysql:8.4.6
MYSQL_PORT=23306
MYSQL_ROOT_PASSWORD=macula-root
MYSQL_APP_USER=macula
MYSQL_APP_PASSWORD=macula

REDIS_IMAGE=redis:7.4.5-alpine
REDIS_PORT=26379

NACOS_IMAGE=nacos/nacos-server:v3.2.4
NACOS_SERVER_PORT=28848
NACOS_CONSOLE_PORT=28080
NACOS_GRPC_PORT=29848
NACOS_NAMESPACE=MACULA5
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=VGhpc0lzTG9jYWxEZXZlbG9wbWVudFRva2VuS2V5MDEyMzQ1Njc4OQ==
NACOS_AUTH_IDENTITY_KEY=macula-local-key
NACOS_AUTH_IDENTITY_VALUE=macula-local-value

IMAGE_REGISTRY=local
IMAGE_TAG=${version}
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
GATEWAY_HOST_PORT=6000
ADMIN_HOST_PORT=5800

# 已运行的 Macula Cloud 是登录、用户与菜单服务的前置条件。
# 浏览器只直接访问 IAM，因此 IAM 必须允许 Admin 来源的 CORS。
MACULA_CLOUD_IAM_URL=http://127.0.0.1:9010

# Admin BFF 和 Gateway 经以下地址访问宿主机上的 Macula Cloud，不会进入 Admin 前端产物。
MACULA_CLOUD_GATEWAY_INTERNAL_URL=http://host.docker.internal:9000
MACULA_CLOUD_IAM_INTERNAL_URL=http://host.docker.internal:9010
MACULA_CLOUD_REDIS_HOST=host.docker.internal
MACULA_CLOUD_REDIS_PORT=16379
MACULA_CLOUD_APP_KEY=${rootArtifactId}-admin-bff
MACULA_CLOUD_APP_SECRET=example

# 仅可使用为本地示例批准的 public/demo client，不要填写生产 secret。
VITE_APP_OAUTH_CLIENT_ID=e4da4a32-592b-46f0-ae1d-784310e88423
VITE_APP_OAUTH_CLIENT_SECRET=secret
VITE_APP_OAUTH_SCOPE=message.read message.write userinfo
VITE_APP_DEMO_USERNAME=admin
VITE_APP_DEMO_PASSWORD=admin
VITE_APP_GATEWAY_PROXY_TARGET=http://127.0.0.1:6000
